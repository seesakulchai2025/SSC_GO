rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อมูลพนักงานทั่วไปยังอ่านได้ด้วย Anonymous Auth ตามรูปแบบเดิม
    // หน้าจอแอปเป็นผู้ซ่อนเมนูตาม role; Rules ใช้การยืนยันตัวตนแบบ Anonymous
    // หมายเหตุด้านความปลอดภัย: กติกานี้เหมาะกับเครื่องมือใช้งานภายในองค์กรขนาดเล็ก-กลาง
    // ที่ไม่ได้เปิดสู่สาธารณะ ถ้าต้องการความปลอดภัยระดับสูงขึ้น (เช่น ป้องกันการเดา PIN
    // จากฝั่ง client) แนะนำให้ย้ายการตรวจสอบ PIN ไปทำผ่าน Cloud Function ในอนาคต

    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /leaveTypes/{typeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /leaveRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      // อนุญาตให้ลบได้ (จำกัดสิทธิ์เฉพาะแอดมินที่ฝั่งแอปเท่านั้น เนื่องจากระบบนี้ไม่ได้แยกสิทธิ์
      // ระดับ Firestore Rules ตาม role — ดูหมายเหตุด้านบน)
      allow delete: if request.auth != null;
    }

    match /holidays/{holidayId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /vehicles/{vehicleId} {
      allow read, write: if request.auth != null;
    }

    match /vehicleCheckouts/{checkoutId} {
      allow read, write: if request.auth != null;
    }

    match /vehicleBookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /systemSettings/{settingId} {
      allow read, write: if request.auth != null;
    }

    match /payrollProfiles/{employeeId} {
      allow read, write: if request.auth != null;
    }

    match /payrollRecords/{payrollRecordId} {
      allow read, write: if request.auth != null;
    }

    match /payrollSnapshots/{periodId} {
      allow read, write: if request.auth != null;
    }

    match /leaveEditAuditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // เอกสารข้อมูลระบบภายใน เช่น ตัวบันทึกว่าปีไหนดึงวันหยุดราชการมาแล้วบ้าง
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

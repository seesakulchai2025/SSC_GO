rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPayrollAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/meta/payrollAdmins)
        && get(/databases/$(database)/documents/meta/payrollAdmins).data.uids is list
        && get(/databases/$(database)/documents/meta/payrollAdmins).data.uids.hasAny([request.auth.uid]);
    }

    function hasNoPayrollFields(data) {
      return !data.keys().hasAny([
        'employmentStatus',
        'baseSalary',
        'employmentDeposit',
        'socialSecurityDeduction',
        'attendanceBonus'
      ]);
    }

    function canUpdateEmployeeWithoutPayrollChanges() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let payrollKeys = [
        'employmentStatus',
        'baseSalary',
        'employmentDeposit',
        'socialSecurityDeduction',
        'attendanceBonus',
        'payrollProfileReady'
      ];
      return (!changedKeys.hasAny(payrollKeys)
          && resource.data.payrollProfileReady == true)
        || (isPayrollAdmin()
          && hasNoPayrollFields(request.resource.data)
          && request.resource.data.payrollProfileReady == true);
    }

    // เอกสารพนักงานทั่วไปต้องผ่าน migration ก่อน; ข้อมูลเงินเดือนอยู่ใน collection ที่จำกัด UID
    // collection อื่นยังใช้ Anonymous Auth ตามรูปแบบเดิม
    // หมายเหตุด้านความปลอดภัย: กติกานี้เหมาะกับเครื่องมือใช้งานภายในองค์กรขนาดเล็ก-กลาง
    // ที่ไม่ได้เปิดสู่สาธารณะ ถ้าต้องการความปลอดภัยระดับสูงขึ้น (เช่น ป้องกันการเดา PIN
    // จากฝั่ง client) แนะนำให้ย้ายการตรวจสอบ PIN ไปทำผ่าน Cloud Function ในอนาคต

    match /employees/{employeeId} {
      allow read: if request.auth != null
        && (isPayrollAdmin() || resource.data.payrollProfileReady == true);
      allow create: if request.auth != null
        && request.resource.data.payrollProfileReady == true
        && hasNoPayrollFields(request.resource.data);
      allow update: if request.auth != null && canUpdateEmployeeWithoutPayrollChanges();
      allow delete: if false;
    }

    match /leaveTypes/{typeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /leaveRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      // อนุญาตให้ลบได้ (จำกัดสิทธิ์เฉพาะแอดมินที่ฝั่งแอปเท่านั้น เนื่องจากระบบนี้ไม่ได้แยกสิทธิ์
      // ระดับ Firestore Rules ตาม role — ดูหมายเหตุด้านบน)
      allow delete: if request.auth != null;
    }

    match /holidays/{holidayId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /payrollProfiles/{employeeId} {
      allow read, write: if isPayrollAdmin();
    }

    match /payrollRecords/{payrollRecordId} {
      allow read, write: if isPayrollAdmin();
    }

    match /leaveEditAuditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // เอกสารข้อมูลระบบภายใน เช่น ตัวบันทึกว่าปีไหนดึงวันหยุดราชการมาแล้วบ้าง
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && docId != 'payrollAdmins';
    }
  }
}
